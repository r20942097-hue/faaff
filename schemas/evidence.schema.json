{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gate": {
      "enum": [
        "tests",
        "clean_extract",
        "archive_integrity",
        "reproducible_build",
        "sbom",
        "provenance",
        "real_environment",
        "rollback"
      ]
    },
    "passed": {
      "const": true
    },
    "scope": {
      "const": "product"
    },
    "details": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "product_id",
    "version",
    "artifact_sha256",
    "source_sha256",
    "gate",
    "passed",
    "scope",
    "details",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

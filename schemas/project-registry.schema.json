{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 4
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "policy_version": {
      "const": "4.0"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "const": "IMPORTED_NOT_REVALIDATED"
        }
      },
      "required": [
        "origin",
        "verification"
      ],
      "additionalProperties": false
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "latest_observed": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "product_verified": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "integration_verified": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "stable": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_known_good": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "RESEARCH",
              "PROTOTYPE",
              "DEV",
              "CANDIDATE",
              "STABLE"
            ]
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "risk_class": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "latest_observed",
          "product_verified",
          "integration_verified",
          "stable",
          "previous_known_good",
          "state",
          "decision",
          "risk_class"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "updated",
    "policy_version",
    "baseline",
    "projects"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

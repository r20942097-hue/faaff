{
  "manifest_version": 3,
  "name": "RPLAY 3-Genre Proposal Prototype (NOT A RELEASE)",
  "version": "0.1.0",
  "version_name": "0.1.0 proposal",
  "minimum_chrome_version": "116",
  "description": "Proposal prototype: RPLAY media candidate detection, YouTube tab control, unified multi-tab manager. Unverified in real browsers.",
  "permissions": ["webRequest", "storage", "alarms", "downloads", "scripting"],
  "host_permissions": [
    "https://rplay.live/*",
    "https://*.rplay.live/*",
    "https://*.rplay-cdn.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "RPLAY / YouTube tabs" },
  "content_scripts": [
    {
      "matches": ["https://rplay.live/*", "https://*.rplay.live/*"],
      "js": ["content_rplay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
